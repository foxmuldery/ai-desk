# Copy values into your local shell or private .env file; never commit real secrets.
# Default to loopback. Non-loopback access requires a 32+ character token and TLS certificate/key.
AI_DESK_BIND=127.0.0.1
AI_DESK_PORT=8765
AI_DESK_DB=./data/ai-desk.sqlite3
AI_DESK_TOKEN=replace-with-a-long-random-secret
# Required only for non-loopback/LAN bind. Use a certificate trusted by the client device.
# AI_DESK_TLS_CERT=/absolute/path/to/fullchain.pem
# AI_DESK_TLS_KEY=/absolute/path/to/private-key.pem
